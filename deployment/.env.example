# Run python3 setup_local.py to generate unique local secrets in .env.
# Do not use empty/example values as credentials.
MYSQL_ROOT_PASSWORD=
MYSQL_AUTH_PASSWORD=
MYSQL_CORE_PASSWORD=
MYSQL_DOCUMENT_PASSWORD=
MYSQL_NOTIFICATION_PASSWORD=
RABBITMQ_PASSWORD=
# Leave JWKS unconfigured until the auth issuance milestone; every token is rejected.
IPETS_JWT_ISSUER=https://localhost.invalid
IPETS_JWT_JWKS_URI=
